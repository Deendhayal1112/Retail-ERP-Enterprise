# =============================================
# Retail ERP Enterprise — Environment Template
# =============================================
# This file IS committed to version control.
# It is a SAFE TEMPLATE with placeholder values.
# Copy to .env and fill in real values.
# NEVER put real secrets in this file.
# =============================================

# ---------------------------------------------
# APPLICATION
# ---------------------------------------------
APP_NAME="Retail ERP Enterprise"
APP_VERSION="0.2.0"
APP_ENV="development"
APP_DEBUG=true

# ---------------------------------------------
# ELECTRON
# ---------------------------------------------
ELECTRON_DEV=true
ELECTRON_LOG_LEVEL="debug"
ELECTRON_ENABLE_LOGGING=true

# Window Dimensions
WIN_WIDTH=1280
WIN_HEIGHT=800
WIN_MIN_WIDTH=1024
WIN_MIN_HEIGHT=700

# ---------------------------------------------
# EXPRESS LOCAL SERVER
# ---------------------------------------------
SERVER_PORT=3721
SERVER_HOST="127.0.0.1"
SERVER_TIMEOUT=30000

# ---------------------------------------------
# SQLITE DATABASE
# ---------------------------------------------
DB_NAME="retail_erp.db"
DB_PATH="./database"
DB_WAL_MODE=true
DB_BUSY_TIMEOUT=5000

# ---------------------------------------------
# SECURITY
# (Replace with real random strings in .env)
# Min length: 64 characters for production
# ---------------------------------------------
SESSION_SECRET="REPLACE_WITH_RANDOM_64_CHAR_STRING"
BCRYPT_ROUNDS=12
JWT_SECRET="REPLACE_WITH_ANOTHER_RANDOM_64_CHAR_STRING"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_MS=900000

# ---------------------------------------------
# LOGGING
# ---------------------------------------------
LOG_LEVEL="debug"
LOG_PATH="./logs"
LOG_MAX_SIZE="20m"
LOG_MAX_FILES="14d"
LOG_COLORIZE=true
