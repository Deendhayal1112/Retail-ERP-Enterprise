# =============================================
# DEPENDENCIES
# =============================================
node_modules/

# =============================================
# BUILD OUTPUT (electron-builder produces these)
# =============================================
dist/
out/
release/

# NOTE: 'build/' is NOT ignored — it contains
# Electron Builder static resources (icons etc.)

# =============================================
# TAILWIND CSS — COMPILED OUTPUT ONLY
# (Source files in styles/ are committed)
# =============================================
src/renderer/styles/output.css

# =============================================
# ENVIRONMENT & SECRETS
# =============================================
.env
.env.local
.env.development
.env.production
.env.staging
# .env.example IS committed — it's a safe template
!.env.example

# =============================================
# DATABASE FILES (local instance — never commit)
# =============================================
*.db
*.sqlite
*.sqlite3
database/retail_erp.db

# =============================================
# LOGS (generated at runtime — never commit)
# =============================================
logs/application/*.log
logs/error/*.log
logs/security/*.log
logs/application/*.txt
logs/error/*.txt
logs/security/*.txt
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# =============================================
# OS GENERATED FILES
# =============================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# =============================================
# IDE & EDITORS
# =============================================
.vscode/settings.json
.vscode/launch.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# =============================================
# CACHE & TEMP
# =============================================
.npm
.eslintcache
.node_repl_history
.tailwindcss/
.cache/
.electron-builder/
*.tmp
*.temp
*.bak
