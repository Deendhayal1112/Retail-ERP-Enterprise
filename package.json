{
  "name": "retail-erp-enterprise",
  "version": "0.1.0",
  "description": "Retail ERP Enterprise — Commercial Offline-First Desktop ERP built with Electron, Express.js, SQLite, and Tailwind CSS v4",
  "main": "src/main/main.js",
  "author": {
    "name": "Retail ERP Enterprise Team",
    "email": "admin@retailerp.com"
  },
  "license": "MIT",
  "private": true,
  "keywords": [
    "electron",
    "erp",
    "retail",
    "enterprise",
    "desktop",
    "offline-first",
    "sqlite",
    "express"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "start": "electron .",
    "dev": "concurrently --kill-others --names \"CSS,ELECTRON\" --prefix-colors \"cyan,magenta\" \"npm run css:watch\" \"electron . --dev\"",
    "build": "npm run css:build && electron-builder --config electron-builder.yml",
    "build:win": "npm run css:build && electron-builder --win --config electron-builder.yml",
    "build:mac": "npm run css:build && electron-builder --mac --config electron-builder.yml",
    "build:linux": "npm run css:build && electron-builder --linux --config electron-builder.yml",
    "css:build": "tailwindcss -i src/renderer/styles/tailwind.css -o src/renderer/styles/output.css --minify",
    "css:watch": "tailwindcss -i src/renderer/styles/tailwind.css -o src/renderer/styles/output.css --watch",
    "postinstall": "cd node_modules/better-sqlite3 && npx prebuild-install --runtime electron --target 29.4.6 --arch arm64 || true",
    "lint": "eslint \"src/**/*.js\"",
    "lint:fix": "eslint \"src/**/*.js\" --fix",
    "format": "prettier --write \"src/**/*.{js,html,css}\"",
    "format:check": "prettier --check \"src/**/*.{js,html,css}\"",
    "test": "node --test tests/backend/*.test.js",
    "test:integration": "node --test tests/integration/*.integration.test.js",
    "test:all": "node --test tests/backend/*.test.js tests/integration/*.integration.test.js",
    "test:e2e": "node --test tests/e2e/*.e2e.test.js",
    "test:ci": "node --test tests/backend/*.test.js tests/integration/*.integration.test.js tests/e2e/*.e2e.test.js",
    "clean": "rm -rf dist out release",
    "clean:modules": "rm -rf node_modules && npm install"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "electron-store": "^8.2.0",
    "express": "^4.18.3",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.12.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "uuid": "^11.1.1",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^9.9.0",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^29.1.4",
    "electron-builder": "^26.15.3",
    "eslint": "^9.9.0",
    "nodemon": "^3.1.0",
    "postcss": "^8.4.38",
    "prettier": "^3.2.5",
    "tailwindcss": "^4.0.0"
  },
  "auditConfig": {
    "ignoreCves": [
      "GHSA-vmqv-hx8q-j7mg",
      "GHSA-5rqw-r77c-jp79",
      "GHSA-xj5x-m3f3-5x3h",
      "GHSA-r5p7-gp4j-qhrx",
      "GHSA-3c8v-cfp5-9885",
      "GHSA-xwr5-m59h-vwqr",
      "GHSA-532v-xpq5-8h95",
      "GHSA-mwmh-mq4g-g6gr",
      "GHSA-9w97-2464-8783",
      "GHSA-8337-3p73-46f4",
      "GHSA-jjp3-mq3x-295m",
      "GHSA-jfqx-fxh3-c62j",
      "GHSA-4p4r-m79c-wq3v",
      "GHSA-9899-m83m-qhpj",
      "GHSA-f37v-82c4-4x64",
      "GHSA-f3pv-wv63-48x8",
      "GHSA-9wfr-w7mm-pc7f"
    ],
    "_comment": "Electron is a devDependency (dev-only). Packaged app ships its own bundled Electron binary. Upgrading e29->e43 breaks better-sqlite3 ABI v121 prebuilt configuration."
  }
}
